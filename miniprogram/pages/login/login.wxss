/**
 * 登录引导页样式
 */

/* ========== Hero ========== */
.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0 40rpx;
}

.hero-logo {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 24rpx;
  opacity: 0.9;
}

.hero-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.hero-sub {
  font-size: var(--font-sm);
  color: var(--color-text-hint);
  margin-top: 12rpx;
}

/* ========== 头像 ========== */
.avatar-section {
  display: flex;
  justify-content: center;
  padding: 20rpx 0;
}

.avatar-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: none;
  border: none;
  padding: 0;
  line-height: 1;
}

.avatar-btn::after {
  border: none;
}

.avatar-preview {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  border: 4rpx solid var(--color-primary-light);
  background: var(--color-bg-warm);
}

.avatar-hint {
  font-size: var(--font-xs);
  color: var(--color-primary);
  margin-top: 16rpx;
}

/* ========== 昵称 ========== */
.nickname-section {
  padding: 40rpx var(--spacing-xl);
}

.nickname-label {
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  margin-bottom: 12rpx;
}

.nickname-input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  font-size: var(--font-lg);
  background: var(--color-bg-card);
  border-radius: var(--radius-md);
  border: 2rpx solid var(--color-border);
  box-sizing: border-box;
}

/* ========== 按钮 ========== */
.btn-group {
  padding: 60rpx var(--spacing-xl) 0;
}

.submit-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  font-size: var(--font-lg);
  font-weight: 600;
  color: #fff;
  background: var(--color-primary);
  border-radius: 48rpx;
  border: none;
  padding: 0;
}

.submit-btn[disabled] {
  background: #c0c0c0;
  color: #fff;
}

.skip-btn {
  text-align: center;
  padding: 32rpx 0;
  font-size: var(--font-sm);
  color: var(--color-text-hint);
}
