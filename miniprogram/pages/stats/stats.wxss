/**
 * 数据统计页样式
 */

/* ========== 概览卡片网格 ========== */
.overview-grid {
  display: flex;
  flex-wrap: wrap;
  margin: var(--spacing-md);
  gap: var(--spacing-sm);
}

.stat-card {
  width: calc(50% - var(--spacing-sm) / 2);
  background: var(--color-bg-card);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-card);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--spacing-lg) var(--spacing-md);
  box-sizing: border-box;
}

.stat-card-icon {
  font-size: 48rpx;
  margin-bottom: var(--spacing-xs);
}

.stat-card-number {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--color-primary-dark);
  line-height: 1.2;
}

.stat-card-label {
  font-size: var(--font-xs);
  color: var(--color-text-hint);
  margin-top: 4rpx;
}

/* ========== 累计记录 ========== */
.record-summary {
  margin: var(--spacing-md);
  padding: var(--spacing-md);
}

.section-title {
  font-size: var(--font-md);
  font-weight: 600;
  color: var(--color-text-primary);
}

.record-total {
  font-size: var(--font-lg);
  font-weight: 700;
  color: var(--color-primary);
}

/* ========== 分布卡片 ========== */
.distro-card {
  margin: var(--spacing-sm) var(--spacing-md);
  padding: var(--spacing-md);
}

.distro-list {
  margin-top: var(--spacing-md);
}

.distro-item {
  display: flex;
  align-items: center;
  margin-bottom: var(--spacing-sm);
}

.distro-item:last-child {
  margin-bottom: 0;
}

.distro-name {
  width: 120rpx;
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  flex-shrink: 0;
}

.distro-bar-bg {
  flex: 1;
  height: 20rpx;
  background: var(--color-bg-warm);
  border-radius: 10rpx;
  margin: 0 var(--spacing-sm);
  overflow: hidden;
}

.distro-bar-fill {
  height: 100%;
  border-radius: 10rpx;
  transition: width 0.6s ease;
}

.color-bar {
  background: linear-gradient(90deg, #F2A65A, #E8B4B8);
}

.gender-bar {
  background: linear-gradient(90deg, #7EC8A8, #5BA4CF);
}

.age-bar {
  background: linear-gradient(90deg, #B8A9D4, #7EC8A8);
}

.distro-count {
  width: 60rpx;
  text-align: right;
  font-size: var(--font-sm);
  font-weight: 600;
  color: var(--color-primary-dark);
  flex-shrink: 0;
}
