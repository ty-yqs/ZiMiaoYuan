<!--
  编辑猫咪信息页
-->
<view class="page-container">

  <!-- ==================== 加载中 ==================== -->
  <view wx:if="{{loading}}" class="loading-tip">
    <text>加载中...</text>
  </view>

  <!-- ==================== 错误 ==================== -->
  <view wx:elif="{{error}}" class="empty-state">
    <text class="empty-icon">😿</text>
    <text class="empty-text">{{error}}</text>
  </view>

  <!-- ==================== 编辑表单 ==================== -->
  <block wx:else>
    <view class="card form-card">

      <!-- 猫咪名称 -->
      <view class="form-item">
        <text class="form-label">猫咪名字</text>
        <input
          class="form-input"
          value="{{cat_name}}"
          placeholder="输入猫咪名字"
          maxlength="20"
          data-field="cat_name"
          bind:input="onFieldChange"
        />
      </view>

      <!-- 毛色 -->
      <view class="form-item">
        <text class="form-label">毛色</text>
        <view class="form-picker" bind:tap="onShowColorPicker">
          <text class="{{color ? '' : 'placeholder'}}">{{color || '请选择毛色'}}</text>
          <text class="picker-arrow">›</text>
        </view>
      </view>

      <!-- 性别 -->
      <view class="form-item">
        <text class="form-label">性别</text>
        <view class="form-picker" bind:tap="onShowGenderPicker">
          <text class="{{gender ? '' : 'placeholder'}}">{{genderLabel || '请选择性别'}}</text>
          <text class="picker-arrow">›</text>
        </view>
      </view>

      <!-- 年龄段 -->
      <view class="form-item">
        <text class="form-label">年龄段</text>
        <view class="form-picker" bind:tap="onShowAgePicker">
          <text class="{{age ? '' : 'placeholder'}}">{{ageLabel || '请选择年龄段'}}</text>
          <text class="picker-arrow">›</text>
        </view>
      </view>

      <!-- 健康状态 -->
      <view class="form-item">
        <text class="form-label">健康状态（点击按钮更改）</text>
        <view class="health-toggles">
          <view class="health-toggle {{healthSterilized ? 'on' : ''}}" bind:tap="onToggleSterilized">
            <text class="health-toggle-text">{{healthSterilized ? '已绝育' : '未绝育'}}</text>
          </view>
          <view class="health-toggle {{healthVaccinated ? 'on' : ''}}" bind:tap="onToggleVaccinated">
            <text class="health-toggle-text">{{healthVaccinated ? '已打疫苗' : '未打疫苗'}}</text>
          </view>
        </view>
      </view>

      <!-- 简介 -->
      <view class="form-item">
        <text class="form-label">简介</text>
        <textarea
          class="form-textarea"
          value="{{description}}"
          placeholder="介绍一下这只猫咪..."
          maxlength="200"
          data-field="description"
          bind:input="onFieldChange"
        />
        <text class="form-count">{{description.length || 0}}/200</text>
      </view>
    </view>

    <!-- 猫咪关系管理（纳入审核流程） -->
    <view class="card form-card">
      <view class="form-item">
        <text class="form-label">猫咪关系</text>

        <!-- 待添加的关系 -->
        <view class="rel-mgmt-list" wx:if="{{pendingRelAdds.length > 0}}">
          <view class="rel-mgmt-item rel-pending-add" wx:for="{{pendingRelAdds}}" wx:key="otherCat._id">
            <view class="rel-mgmt-info">
              <text class="rel-mgmt-badge">📥</text>
              <text class="rel-mgmt-label">{{item.label}}</text>
              <text class="rel-mgmt-name">- {{item.otherCat.cat_name}}</text>
              <text class="rel-mgmt-pending-tag">待审核</text>
            </view>
            <view class="rel-mgmt-undo" data-index="{{index}}" catch:tap="onUndoPendingRelAdd">撤销</view>
          </view>
        </view>

        <!-- 现有关系列表（只读展示） -->
        <view class="rel-mgmt-list" wx:if="{{relationships.length > 0}}">
          <view
            wx:for="{{relationships}}"
            wx:key="_id"
            class="rel-mgmt-item"
          >
            <view class="rel-mgmt-info">
              <text class="rel-mgmt-badge">
                <text wx:if="{{item.type === 'parent_child'}}">👨‍👩‍👧</text>
                <text wx:elif="{{item.type === 'sibling'}}">🐱</text>
                <text wx:elif="{{item.type === 'mate'}}">💕</text>
                <text wx:elif="{{item.type === 'ex_mate'}}">💔</text>
                <text wx:elif="{{item.type === 'friend'}}">🤝</text>
                <text wx:elif="{{item.type === 'rival'}}">⚡</text>
                <text wx:else>🔗</text>
              </text>
              <text class="rel-mgmt-label">{{item.label}}</text>
              <text class="rel-mgmt-name">- {{item.otherCat.cat_name}}</text>
            </view>
          </view>
        </view>

        <!-- 添加关系按钮 -->
        <view class="add-rel-btn" bind:tap="onShowRelationshipModal">
          <text class="add-rel-icon">+</text>
          <text class="add-rel-text">添加关系</text>
        </view>
      </view>
    </view>

    <!-- 提示 -->
    <view class="notice">
      <text class="notice-text">* 编辑提交后需管理员审核，通过后才会更新显示</text>
    </view>

    <!-- 提交按钮 -->
    <view class="submit-area">
      <button class="submit-btn" bind:tap="onSubmit" loading="{{submitting}}">
        提交编辑
      </button>
    </view>
  </block>

</view>

<!-- ==================== 毛色选择器弹窗 ==================== -->
<view class="picker-overlay" wx:if="{{showColorPicker}}" bind:tap="onCloseColorPicker">
  <view class="picker-panel" catch:tap="noop">
    <view class="picker-header">
      <text class="picker-title">选择毛色</text>
      <text class="picker-close" bind:tap="onCloseColorPicker">✕</text>
    </view>
    <view class="picker-grid">
      <view
        wx:for="{{colorOptions}}"
        wx:key="value"
        class="picker-item {{color === item.value ? 'active' : ''}}"
        data-value="{{item.value}}"
        bind:tap="onSelectColor"
      >{{item.text}}</view>
    </view>
  </view>
</view>

<!-- ==================== 性别选择器弹窗 ==================== -->
<view class="picker-overlay" wx:if="{{showGenderPicker}}" bind:tap="onCloseGenderPicker">
  <view class="picker-panel" catch:tap="noop">
    <view class="picker-header">
      <text class="picker-title">选择性别</text>
      <text class="picker-close" bind:tap="onCloseGenderPicker">✕</text>
    </view>
    <view class="picker-list">
      <view
        wx:for="{{genderOptions}}"
        wx:key="value"
        class="picker-item picker-item-row {{gender === item.value ? 'active' : ''}}"
        data-value="{{item.value}}"
        bind:tap="onSelectGender"
      >{{item.label}}</view>
    </view>
  </view>
</view>

<!-- ==================== 年龄段选择器弹窗 ==================== -->
<view class="picker-overlay" wx:if="{{showAgePicker}}" bind:tap="onCloseAgePicker">
  <view class="picker-panel" catch:tap="noop">
    <view class="picker-header">
      <text class="picker-title">选择年龄段</text>
      <text class="picker-close" bind:tap="onCloseAgePicker">✕</text>
    </view>
    <view class="picker-list">
      <view
        wx:for="{{ageOptions}}"
        wx:key="value"
        class="picker-item picker-item-row {{age === item.value ? 'active' : ''}}"
        data-value="{{item.value}}"
        bind:tap="onSelectAge"
      >{{item.label}}</view>
    </view>
  </view>
</view>

<!-- ==================== 添加关系弹窗 ==================== -->
<view class="picker-overlay" wx:if="{{showRelationshipModal}}" bind:tap="onCloseRelationshipModal">
  <view class="picker-panel" catch:tap="noop" style="max-height: 80vh;">
    <view class="picker-header">
      <text class="picker-title">添加关系</text>
      <text class="picker-close" bind:tap="onCloseRelationshipModal">✕</text>
    </view>

    <!-- 搜索对方猫咪 -->
    <view class="rel-search-section">
      <input
        class="rel-search-input"
        value="{{relSearchKeyword || ''}}"
        placeholder="搜索猫咪名字..."
        bind:input="onRelSearchInput"
      />
      <view class="rel-search-results" wx:if="{{relSearchResults.length > 0}}">
        <view
          wx:for="{{relSearchResults}}"
          wx:key="_id"
          class="rel-search-item {{relSelectedCat && relSelectedCat._id === item._id ? 'active' : ''}}"
          data-cat="{{item}}"
          bind:tap="onSelectSearchCat"
        >
          <image class="rel-search-avatar" src="{{item.avatar}}" mode="aspectFill" />
          <view class="rel-search-info">
            <text class="rel-search-name">{{item.cat_name}}</text>
            <view class="rel-search-meta">
              <image wx:if="{{item.gender === 'male'}}" class="rel-search-gender-icon" src="/images/gender-male-color.svg" />
              <image wx:elif="{{item.gender === 'female'}}" class="rel-search-gender-icon" src="/images/gender-female-color.svg" />
              <text>· {{item.color}}</text>
            </view>
          </view>
        </view>
      </view>
      <view class="rel-search-empty" wx:elif="{{relSearchKeyword && !relSearching && relSearchResults.length === 0}}">
        <text>未找到匹配的猫咪</text>
      </view>
      <view class="rel-selected-hint" wx:if="{{relSelectedCat}}">
        <text>已选择：{{relSelectedCat.cat_name}}</text>
      </view>
    </view>

    <!-- 关系类型选择 -->
    <view class="rel-type-section" wx:if="{{relSelectedCat}}">
      <text class="rel-type-title">选择关系类型</text>
      <view class="rel-type-grid">
        <view
          wx:for="{{relationshipTypes}}"
          wx:key="value"
          class="rel-type-item {{relSelectedType === item.value ? 'active' : ''}}"
          data-type="{{item.value}}"
          bind:tap="onSelectRelType"
        >
          <text class="rel-type-label-text">{{item.label}}</text>
        </view>
      </view>

      <!-- parent_child 方向切换 -->
      <view class="rel-direction-toggle" wx:if="{{relSelectedType === 'parent_child'}}">
        <text class="rel-direction-text">亲子方向：</text>
        <view class="rel-direction-switch" bind:tap="onToggleParentDirection">
          <text class="{{relParentIsCurrent ? 'active' : ''}}">本猫是父母</text>
          <text class="{{!relParentIsCurrent ? 'active' : ''}}">对方是父母</text>
        </view>
      </view>

      <!-- other 类型描述 -->
      <view class="rel-desc-section" wx:if="{{relSelectedType === 'other'}}">
        <textarea
          class="rel-desc-input"
          value="{{relDescription || ''}}"
          placeholder="描述这两个猫咪的关系..."
          maxlength="100"
          bind:input="onRelDescInput"
        />
      </view>
    </view>

    <!-- 提交按钮 -->
    <view class="rel-submit-area" wx:if="{{relSelectedCat && relSelectedType}}">
      <button
        class="rel-submit-btn"
        bind:tap="onSubmitRelationship"
        loading="{{relSubmitting}}"
        disabled="{{!relSelectedType || !relSelectedCat}}"
      >确认添加</button>
    </view>

  </view>
</view>
