<!--
  猫咪档案列表页
  支持搜索、筛选、触底加载
-->
<view class="page-container">

  <!-- ==================== 顶部固定区 ==================== -->
  <view class="sticky-header">
    <view class="search-bar">
      <van-search
        value="{{searchKeyword}}"
        placeholder="搜索猫咪名字"
        bind:search="onSearch"
        bind:clear="onSearch"
        shape="round"
        background="#FFF8EC"
      />
    </view>
    <view class="filter-bar">
      <view class="filter-dropdown-wrap">
        <van-dropdown-menu active-color="#7EC8A8">
          <van-dropdown-item
            options="{{colorOptions}}"
            value="{{filterColor}}"
            bind:change="onFilterColor"
          />
          <van-dropdown-item
            options="{{genderOptions}}"
            value="{{filterGender}}"
            bind:change="onFilterGender"
          />
          <van-dropdown-item
            options="{{ageOptions}}"
            value="{{filterAge}}"
            bind:change="onFilterAge"
          />
        </van-dropdown-menu>
      </view>
      <text class="sort-btn {{sortByRating ? 'sort-active' : ''}}" bind:tap="onToggleSort">亲人{{sortByRating ? (sortOrder === 'desc' ? '↓' : '↑') : ''}}</text>
    </view>
  </view>

  <!-- 占位，防止被 fixed 头部遮挡 -->
  <view class="list-spacer" />

  <!-- ==================== 加载中 ==================== -->
  <view wx:if="{{loading && cats.length === 0}}" class="loading-wrapper">
    <van-loading type="spinner" size="48rpx" color="#7EC8A8" />
    <text class="loading-text">加载中...</text>
  </view>

  <!-- ==================== 错误 ==================== -->
  <view wx:elif="{{error && cats.length === 0}}" class="error-wrapper">
    <van-empty description="{{error}}" />
    <view class="retry-btn" bind:tap="loadCats">点击重试</view>
  </view>

  <!-- ==================== 空状态 ==================== -->
  <view wx:elif="{{cats.length === 0}}" class="empty-state">
    <text class="empty-icon">😿</text>
    <text class="empty-text">还没有猫咪档案</text>
    <button wx:if="{{uploadOpen}}" class="add-btn" bind:tap="onTapUpload">去发现第一只猫</button>
  </view>

  <!-- ==================== 猫咪列表 ==================== -->
  <block wx:else>
    <cat-card
      wx:for="{{cats}}"
      wx:key="_id"
      cat="{{item}}"
      showLocation="{{false}}"
    />

    <!-- 加载更多 -->
    <view class="load-more">
      <van-loading wx:if="{{loading}}" type="spinner" size="32rpx" color="#7EC8A8" />
      <text wx:elif="{{!hasMore}}">—— 已经到底了 ——</text>
    </view>
  </block>

  <!-- 发布按钮（发现猫咪入口，受全局开关控制） -->
  <view class="fab" wx:if="{{uploadOpen}}" bind:tap="onTapUpload">
    <text class="fab-icon">+</text>
  </view>

</view>
