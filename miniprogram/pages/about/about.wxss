/**
 * 关于紫喵园页样式
 */

/* ========== 页面容器 ========== */
.page-container {
  min-height: 100vh;
  background: var(--color-bg-warm);
  padding-bottom: env(safe-area-inset-bottom);
}

/* ========== 品牌区 ========== */
.hero-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0 48rpx;
}

.app-icon-wrapper {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, rgba(126, 200, 168, 0.15), rgba(126, 200, 168, 0.3));
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(126, 200, 168, 0.15);
}

.app-icon {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
}

.app-name {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  letter-spacing: 4rpx;
}

.app-subtitle {
  font-size: var(--font-sm);
  color: var(--color-text-hint);
  margin-top: 8rpx;
  letter-spacing: 2rpx;
}

.app-version {
  font-size: var(--font-xs);
  color: var(--color-primary);
  background: rgba(126, 200, 168, 0.1);
  padding: 6rpx 24rpx;
  border-radius: 24rpx;
  margin-top: 16rpx;
}

/* ========== 卡片 ========== */
.about-card {
  margin: 0 var(--spacing-md) var(--spacing-md);
  padding: var(--spacing-md);
}

.about-title {
  font-size: var(--font-md);
  font-weight: 600;
  color: var(--color-text-primary);
  display: block;
  margin-bottom: 16rpx;
}

.about-desc {
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  line-height: 1.8;
}

/* ========== 功能列表 ========== */
.feature-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.feature-item {
  display: flex;
  align-items: center;
}

.feature-icon {
  font-size: 32rpx;
  width: 48rpx;
  text-align: center;
  flex-shrink: 0;
}

.feature-text {
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  margin-left: 12rpx;
}

/* ========== GitHub ========== */
.github-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx;
  background: var(--color-bg-warm);
  border-radius: var(--radius-sm);
}

.github-row:active {
  background: rgba(126, 200, 168, 0.1);
}

.github-url {
  font-size: 24rpx;
  color: var(--color-primary);
  word-break: break-all;
  flex: 1;
}

.copy-hint {
  font-size: var(--font-xs);
  color: var(--color-text-hint);
  margin-left: 16rpx;
  flex-shrink: 0;
}

.opensource-note {
  font-size: var(--font-xs);
  color: var(--color-text-hint);
  margin-top: 12rpx;
  display: block;
  text-align: center;
}

/* ========== 技术栈标签 ========== */
.tech-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tech-tag {
  font-size: var(--font-xs);
  color: var(--color-primary);
  background: rgba(126, 200, 168, 0.08);
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  border: 1rpx solid rgba(126, 200, 168, 0.2);
}

/* ========== 底部 ========== */
.about-footer {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx var(--spacing-md) 48rpx;
}

.footer-text {
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
}

.icp-text {
  font-size: var(--font-xs);
  color: var(--color-text-hint);
  margin-top: 8rpx;
}

.copyright-text {
  font-size: var(--font-xs);
  color: var(--color-text-hint);
  margin-top: 4rpx;
}
