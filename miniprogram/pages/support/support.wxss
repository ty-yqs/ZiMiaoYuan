/**
 * 投喂罐头 — 赞助支持页样式
 */

/* ========== 说明区域 ========== */
.support-intro {
  text-align: center;
  padding-top: var(--spacing-xl);
  padding-bottom: var(--spacing-xl);
}

.support-icon {
  font-size: 80rpx;
  margin-bottom: var(--spacing-sm);
}

.support-title {
  display: block;
  font-size: var(--font-xl);
  font-weight: 700;
  color: var(--color-text-primary);
  margin-bottom: var(--spacing-md);
}

.support-desc {
  display: block;
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  line-height: 1.8;
}

/* ========== 投喂按钮区域 ========== */
.support-action {
  padding-top: var(--spacing-lg);
  padding-bottom: var(--spacing-lg);
}

.action-hint {
  font-size: var(--font-sm);
  color: var(--color-text-hint);
  margin-bottom: var(--spacing-md);
  text-align: center;
}

.feed-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  width: 320rpx;
  padding: 24rpx 0;
  background: linear-gradient(135deg, var(--color-accent), #F7B84E);
  color: #fff;
  border-radius: 50rpx;
  font-size: var(--font-lg);
  font-weight: 700;
  box-shadow: 0 8rpx 24rpx rgba(242, 166, 90, 0.35);
}

.feed-btn-icon {
  font-size: 40rpx;
}

/* ========== 赞助名单 ========== */
.supporters-card {
  margin-bottom: var(--spacing-lg);
}

.section-title {
  font-size: var(--font-md);
  font-weight: 600;
  color: var(--color-text-primary);
  margin-bottom: var(--spacing-sm);
  padding-bottom: var(--spacing-sm);
  border-bottom: 1rpx solid var(--color-border);
}

.supporter-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--spacing-sm) 0;
  border-bottom: 1rpx solid var(--color-border);
}

.supporter-item:last-child {
  border-bottom: none;
}

.supporter-left {
  display: flex;
  flex-direction: column;
}

.supporter-name {
  font-size: var(--font-md);
  color: var(--color-text-primary);
  font-weight: 500;
}

.supporter-month {
  font-size: var(--font-xs);
  color: var(--color-text-hint);
  margin-top: 2rpx;
}

.supporter-amount {
  font-size: var(--font-lg);
  font-weight: 700;
  color: var(--color-accent);
}

/* ========== 空状态补充 ========== */
.empty-subtext {
  font-size: var(--font-xs);
  color: var(--color-text-hint);
  margin-top: 4rpx;
}

/* ========== 二维码弹窗 ========== */
.qr-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.qr-panel {
  width: 560rpx;
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  padding: var(--spacing-lg);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.qr-header {
  width: 100%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--spacing-md);
}

.qr-title {
  font-size: var(--font-lg);
  font-weight: 700;
  color: var(--color-text-primary);
}

.qr-close {
  font-size: var(--font-lg);
  color: var(--color-text-hint);
  padding: 8rpx;
}

.qr-image {
  width: 400rpx;
  height: 400rpx;
  border-radius: var(--radius-md);
  background: var(--color-bg-warm);
  margin-bottom: var(--spacing-md);
}

.qr-hint {
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  margin-bottom: 8rpx;
}

.qr-thanks {
  font-size: var(--font-xs);
  color: var(--color-accent);
}

/* ========== 费用明细图 ========== */
.cost-section {
  margin: var(--spacing-sm) var(--spacing-md);
  border-radius: var(--radius-md);
  overflow: hidden;
}

.cost-image {
  width: 100%;
  display: block;
}
