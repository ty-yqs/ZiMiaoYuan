<!--
  投喂罐头 — 赞助支持页
-->
<view class="page-container">

  <!-- ==================== 说明区域 ==================== -->
  <view class="card support-intro">
    <view class="support-icon">🍰</view>
    <text class="support-title">投喂一个罐头吧！</text>
    <text class="support-desc">小程序维护不易，存储、流量和函数调用均为计费项目</text>
    <text class="support-desc">小程序维护不易，存储、流量和函数调用均为计费项目</text>
    <text class="support-desc">每一份投喂都将用于小程序服务器与存储的维护费用</text>
    <text class="support-desc">感谢您对紫喵园的支持，每一只校园猫咪都会记得你的善意</text>
  </view>

  <!-- ==================== 投喂按钮 ==================== -->
  <view class="card support-action flex-column flex-center">
    <text class="action-hint">您的每一份支持，都将用于小程序服务器与存储维护</text>
    <button class="feed-btn" bind:tap="onShowQR">
      <text class="feed-btn-icon">🍰</text>
      <text>投喂罐头</text>
    </button>
  </view>

  <!-- ==================== 赞助名单 ==================== -->
  <view class="card supporters-card" wx:if="{{supporters.length > 0}}">
    <view class="section-title">💜 赞助名单（每月月初更新）</view>

    <view class="supporter-item" wx:for="{{supporters}}" wx:key="_id">
      <view class="supporter-left">
        <text class="supporter-name">{{item.name}}</text>
        <text class="supporter-month">{{item.month}}</text>
      </view>
      <text class="supporter-amount">¥{{item.amount}}</text>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:elif="{{!loading && supporters.length === 0}}">
    <text class="empty-icon">😿</text>
    <text class="empty-text">还没有赞助记录</text>
    <text class="empty-subtext">成为第一个投喂罐头的人吧！</text>
  </view>

  <!-- 加载中 -->
  <view wx:if="{{loading}}" class="loading-tip">
    <text>正在加载...</text>
  </view>

  <!-- 费用明细 -->
  <view class="cost-section">
    <image class="cost-image" src="/images/cost.png" mode="widthFix" bind:tap="onPreviewCost" />
  </view>

</view>

<!-- ==================== 二维码弹窗 ==================== -->
<view class="qr-overlay" wx:if="{{showQR}}" bind:tap="onCloseQR">
  <view class="qr-panel" catch:tap="noop">
    <view class="qr-header">
      <text class="qr-title">🍰 投喂罐头</text>
      <text class="qr-close" bind:tap="onCloseQR">✕</text>
    </view>
    <image class="qr-image" src="{{qrUrl}}" mode="aspectFit" />
    <text class="qr-hint">截屏后退出小程序扫描二维码投喂罐头</text>
    <text class="qr-thanks">感谢您的每一份善意 💜</text>
  </view>
</view>
