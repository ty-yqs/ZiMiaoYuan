<!--
  管理员后台
-->
<view class="page-container">

  <!-- ==================== Tab 切换（始终显示） ==================== -->
  <van-tabs active="{{activeTab}}" bind:click="onTabChange" color="#7EC8A8">

    <van-tab title="待审核 ({{pendingCats.length}})">
      <!-- 加载中 -->
      <block wx:if="{{loading}}">
        <view class="tab-loading"><text>加载中...</text></view>
      </block>

      <!-- 空状态 -->
      <block wx:elif="{{pendingCats.length === 0}}">
        <view class="empty-state">
          <text class="empty-text">没有待审核的猫咪</text>
        </view>
      </block>

      <!-- 列表 -->
      <block wx:else>
        <view wx:for="{{pendingCats}}" wx:key="_id" class="card admin-card review-card">

        <!-- 照片轮播 -->
        <view class="review-photos" wx:if="{{item.cachedPhotos && item.cachedPhotos.length > 0}}">
          <scroll-view scroll-x class="review-photo-scroll">
            <image
              wx:for="{{item.cachedPhotos}}"
              wx:key="*this"
              class="review-photo-item"
              src="{{item}}"
              mode="aspectFill"
              data-url="{{item}}"
              data-urls="{{item.cachedPhotos}}"
              bind:tap="onPreviewPhotos"
            />
          </scroll-view>
        </view>

        <!-- 完整信息 -->
        <view class="review-info">
          <text class="admin-cat-name">{{item.cat_name || '未命名'}}</text>

          <view class="review-tags">
            <van-tag type="warning" size="mini">待审核</van-tag>
            <text class="review-gender" wx:if="{{item.genderLabel}}">{{item.genderLabel}}</text>
          </view>

          <view class="review-detail-grid">
            <text class="admin-cat-detail">毛色：{{item.color}}</text>
            <text class="admin-cat-detail">年龄：{{item.ageLabel || '未知'}}</text>
            <text class="admin-cat-detail">地点：{{item.location.name}}</text>
          </view>

          <view class="review-health">
            <text class="health-item {{item.health && item.health.sterilized ? 'done' : ''}}">
              {{item.health && item.health.sterilized ? '已绝育' : '未绝育'}}
            </text>
            <text class="health-item {{item.health && item.health.vaccinated ? 'done' : ''}}">
              {{item.health && item.health.vaccinated ? '已打疫苗' : '未打疫苗'}}
            </text>
          </view>

          <view class="review-desc" wx:if="{{item.description}}">
            <text class="review-desc-label">简介：</text>
            <text class="review-desc-text">{{item.description}}</text>
          </view>
        </view>

        <view class="admin-actions flex-row">
          <van-button
            type="primary"
            size="small"
            color="#7EC8A8"
            data-cat-id="{{item._id}}"
            bind:click="onApprove"
          >通过</van-button>
          <van-button
            type="danger"
            size="small"
            data-cat-id="{{item._id}}"
            bind:click="onReject"
          >拒绝</van-button>
        </view>
      </view>
      </block>
    </van-tab>

    <van-tab title="编辑审核 ({{pendingEdits.length}})">
      <block wx:if="{{loading}}">
        <view class="tab-loading"><text>加载中...</text></view>
      </block>

      <block wx:elif="{{pendingEdits.length === 0}}">
        <view class="empty-state">
          <text class="empty-text">没有待审核的编辑</text>
        </view>
      </block>

      <block wx:else>
        <view wx:for="{{pendingEdits}}" wx:key="_id" class="card admin-card">
        <view class="edit-proposal-info">
          <text class="admin-cat-name">{{item.catName}}</text>
          <text class="admin-cat-detail">提案者：{{item.nickname || '匿名猫友'}}</text>
          <text class="admin-cat-detail">提交时间：{{item.createTime}}</text>

          <view class="edit-changes">
            <text class="edit-change-label">修改内容：</text>
            <block wx:for="{{item.changesList}}" wx:for-item="change" wx:key="key">
              <view class="edit-change-item">
                <text class="edit-change-key">{{change.key}}</text>
                <text class="edit-change-arrow">→</text>
                <text class="edit-change-val">{{change.value}}</text>
              </view>
            </block>
            <!-- 无字段变更时提示 -->
            <text wx:if="{{item.changesList.length === 0}}" class="edit-change-empty">无字段修改</text>
          </view>

          <!-- 关系变更 -->
          <view class="edit-changes" wx:if="{{item.hasRelChanges}}">
            <text class="edit-change-label">关系变更：</text>
            <block wx:for="{{item.relChanges}}" wx:for-item="rc" wx:key="text">
              <view class="edit-change-item">
                <van-tag wx:if="{{rc.action === 'add'}}" type="success" size="mini">新增</van-tag>
                <van-tag wx:else type="danger" size="mini">删除</van-tag>
                <text class="edit-change-suffix">{{rc.text}}</text>
              </view>
            </block>
          </view>
        </view>

        <view class="admin-actions flex-row">
          <van-button
            type="primary"
            size="small"
            color="#7EC8A8"
            data-proposal-id="{{item._id}}"
            bind:click="onApproveEdit"
          >通过</van-button>
          <van-button
            type="danger"
            size="small"
            data-proposal-id="{{item._id}}"
            bind:click="onRejectEdit"
          >拒绝</van-button>
        </view>
      </view>
      </block>
    </van-tab>

    <van-tab title="全部猫咪 ({{allCatsTotal}})">
      <!-- 瀑布流猫咪卡片 -->
      <block wx:if="{{allCats.length > 0}}">
        <view wx:for="{{allCats}}" wx:key="_id">
          <cat-card cat="{{item}}" showLocation="{{false}}" />
          <view class="admin-card-actions flex-row">
            <van-button
              type="{{item.adopted ? 'default' : 'primary'}}"
              size="small"
              color="#E8A87C"
              data-cat-id="{{item._id}}"
              bind:click="onToggleAdopted"
            >{{item.adopted ? '取消领养' : '标记已领养'}}</van-button>
            <van-button
              type="{{item.passedAway ? 'default' : 'primary'}}"
              size="small"
              color="#9B9B9B"
              data-cat-id="{{item._id}}"
              bind:click="onTogglePassedAway"
            >{{item.passedAway ? '取消去喵星' : '标记去喵星'}}</van-button>
            <van-button
              type="{{item.missing ? 'default' : 'primary'}}"
              size="small"
              color="#9B9B9B"
              data-cat-id="{{item._id}}"
              bind:click="onToggleMissing"
            >{{item.missing ? '取消失踪' : '标记失踪'}}</van-button>
            <van-button
              type="danger"
              size="small"
              plain
              hairline
              data-cat-id="{{item._id}}"
              bind:click="onDelete"
            >删除</van-button>
          </view>
        </view>

        <!-- 加载更多 -->
        <view class="load-more">
          <text wx:if="{{allCatsLoading}}">正在加载...</text>
          <text wx:elif="{{!allCatsHasMore}}">—— 已经到底了 ——</text>
        </view>
      </block>

      <!-- 空状态 -->
      <view class="empty-state" wx:elif="{{!allCatsLoading}}">
        <text class="empty-text">还没有猫咪</text>
      </view>

      <!-- 首次加载中 -->
      <view class="tab-loading" wx:else>
        <text>加载中...</text>
      </view>
    </van-tab>
  </van-tabs>

</view>
