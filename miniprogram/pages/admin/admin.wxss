/**
 * 管理员后台样式
 */

/* ========== Tab 内加载中 ========== */
.tab-loading {
  padding: 80rpx 0;
  text-align: center;
  font-size: var(--font-sm);
  color: var(--color-text-hint);
}

/* ========== 管理员卡片 ========== */
.admin-card {
  margin: var(--spacing-sm) var(--spacing-md);
  overflow: hidden;
}

.admin-cat-img {
  width: 100rpx;
  height: 100rpx;
  border-radius: var(--radius-md);
  background: var(--color-bg-warm);
  flex-shrink: 0;
}

.admin-cat-info {
  margin-left: var(--spacing-sm);
  min-width: 0;
}

.admin-cat-name {
  font-size: var(--font-md);
  font-weight: 600;
  display: block;
  margin-bottom: 4rpx;
}

.admin-cat-detail {
  font-size: var(--font-xs);
  color: var(--color-text-secondary);
  display: block;
  margin-bottom: 2rpx;
}

.admin-actions {
  margin-top: var(--spacing-sm);
  gap: var(--spacing-sm);
  justify-content: flex-end;
  flex-wrap: wrap;
  padding-top: var(--spacing-sm);
  border-top: 1rpx solid var(--color-border);
}

/* 全部猫咪 tab 下的卡片操作按钮 */
.admin-card-actions {
  gap: var(--spacing-sm);
  justify-content: flex-end;
  flex-wrap: wrap;
  padding: 0 var(--spacing-md) var(--spacing-sm) var(--spacing-md);
}

/* 加载更多 */
.load-more {
  padding: 32rpx 0;
  text-align: center;
  font-size: var(--font-xs);
  color: var(--color-text-hint);
}

/* ========== 审核卡片（完整信息） ========== */
.review-card {
  padding: var(--spacing-sm);
}

/* 照片轮播 */
.review-photos {
  margin: -4rpx -4rpx 16rpx -4rpx;
}

.review-photo-scroll {
  display: flex;
  flex-direction: row;
  white-space: nowrap;
  width: 100%;
}

.review-photo-item {
  display: inline-block;
  width: 200rpx;
  height: 200rpx;
  border-radius: var(--radius-sm);
  margin-right: 12rpx;
  background: var(--color-bg-warm);
  flex-shrink: 0;
}

/* 信息区 */
.review-info {
  padding: 0 4rpx;
}

.review-tags {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 12rpx;
}

.review-gender {
  font-size: 22rpx;
  color: var(--color-accent);
}

.review-detail-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 4rpx 16rpx;
  margin-bottom: 12rpx;
}

.review-detail-grid .admin-cat-detail {
  font-size: 24rpx;
  margin-bottom: 4rpx;
}

/* 健康状态 */
.review-health {
  display: flex;
  gap: 24rpx;
  margin-bottom: 12rpx;
}

.health-item {
  font-size: 24rpx;
  color: var(--color-text-hint);
}

.health-item.done {
  color: var(--color-primary-dark);
}

/* 简介 */
.review-desc {
  margin-top: 8rpx;
  padding: 12rpx;
  background: var(--color-bg-warm);
  border-radius: var(--radius-sm);
}

.review-desc-label {
  font-size: 22rpx;
  color: var(--color-text-hint);
}

.review-desc-text {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 1.5;
}

/* ========== 编辑提案 ========== */
.edit-proposal-info {
  padding: 0 0 var(--spacing-sm) 0;
}

.edit-changes {
  margin-top: 12rpx;
  padding: 16rpx;
  background: var(--color-bg-warm);
  border-radius: var(--radius-sm);
}

.edit-change-label {
  font-size: var(--font-xs);
  color: var(--color-text-hint);
  display: block;
  margin-bottom: 8rpx;
}

.edit-change-item {
  display: flex;
  align-items: center;
  margin-bottom: 4rpx;
  font-size: 24rpx;
}

.edit-change-item:last-child {
  margin-bottom: 0;
}

.edit-change-key {
  color: var(--color-text-hint);
  min-width: 100rpx;
}

.edit-change-arrow {
  color: var(--color-accent);
  margin: 0 8rpx;
  font-weight: 600;
}

.edit-change-val {
  color: var(--color-text-primary);
  font-weight: 500;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.edit-change-empty {
  font-size: 24rpx;
  color: var(--color-text-hint);
}

.edit-change-suffix {
  font-size: 24rpx;
  color: var(--color-text-primary);
  margin-left: 8rpx;
}

/* ========== 提交者信息 ========== */
.review-submitter {
  display: block;
  font-size: var(--font-xs);
  color: var(--color-text-hint);
  margin-top: 6rpx;
}

/* ========== 记录审核 ========== */
.record-review-info {
  padding: var(--spacing-sm) 0;
}

.record-review-header {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
  margin-bottom: 8rpx;
}

.record-cat-name {
  font-size: var(--font-md);
  font-weight: 600;
  color: var(--color-text-primary);
}

.record-review-meta {
  display: block;
  font-size: var(--font-xs);
  color: var(--color-text-hint);
  margin-top: 4rpx;
}

.record-review-desc {
  margin-top: var(--spacing-sm);
  padding: var(--spacing-sm);
  background: var(--color-bg-warm);
  border-radius: var(--radius-sm);
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  line-height: 1.5;
}

.record-review-photo {
  width: 200rpx;
  height: 200rpx;
  border-radius: var(--radius-sm);
  margin-top: var(--spacing-sm);
  background: var(--color-bg-warm);
}

/* ========== 驳回弹窗 ========== */
.reject-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 2000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.reject-panel {
  width: 600rpx;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

.reject-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx var(--spacing-md);
  border-bottom: 1rpx solid var(--color-border);
}

.reject-title {
  font-size: var(--font-md);
  font-weight: 600;
}

.reject-close {
  font-size: 32rpx;
  color: var(--color-text-hint);
  padding: 8rpx;
}

.reject-textarea {
  width: 100%;
  height: 160rpx;
  padding: var(--spacing-md);
  font-size: var(--font-sm);
  box-sizing: border-box;
}

.reject-footer {
  display: flex;
  gap: var(--spacing-sm);
  padding: var(--spacing-sm) var(--spacing-md);
  padding-bottom: var(--spacing-md);
}

.reject-cancel-btn {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  font-size: var(--font-sm);
  background: var(--color-bg);
  border-radius: 36rpx;
  border: none;
  padding: 0;
}

.reject-confirm-btn {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  font-size: var(--font-sm);
  color: #fff;
  background: #e74c3c;
  border-radius: 36rpx;
  border: none;
  padding: 0;
}

.reject-confirm-btn[disabled] {
  background: #ddd;
  color: #999;
}
