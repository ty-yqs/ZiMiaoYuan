/**
 * 反馈页样式
 */

.feedback-card {
  margin-top: var(--spacing-md);
}

.feedback-label {
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  margin-bottom: 12rpx;
  display: block;
}

.feedback-textarea {
  width: 100%;
  height: 320rpx;
  font-size: var(--font-md);
  line-height: 1.6;
  padding: 16rpx;
  background: var(--color-bg-warm);
  border-radius: var(--radius-sm);
  box-sizing: border-box;
}

.feedback-count {
  text-align: right;
  font-size: var(--font-xs);
  color: var(--color-text-hint);
  margin-top: 8rpx;
}

.contact-card {
  margin-top: var(--spacing-sm);
}

.contact-input {
  width: 100%;
  height: 80rpx;
  padding: 0 16rpx;
  font-size: var(--font-md);
  background: var(--color-bg-warm);
  border-radius: var(--radius-sm);
}

.submit-area {
  padding: 40rpx var(--spacing-md);
}

.submit-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  font-size: var(--font-lg);
  font-weight: 600;
  color: #fff;
  background: var(--color-primary);
  border-radius: 48rpx;
  border: none;
  padding: 0;
}

.submit-btn[disabled] {
  background: #c0c0c0;
  color: #fff;
}
