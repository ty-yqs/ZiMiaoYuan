<!--
  反馈与建议页
-->
<view class="page-container">

  <view class="card feedback-card">
    <text class="feedback-label">反馈内容</text>
    <textarea
      class="feedback-textarea"
      value="{{content}}"
      placeholder="请输入你的反馈与建议..."
      maxlength="500"
      auto-focus
      bind:input="onInput"
    />
    <text class="feedback-count">{{content.length || 0}}/500</text>
  </view>

  <view class="card contact-card">
    <text class="feedback-label">联系方式（选填）</text>
    <input
      class="contact-input"
      value="{{contact}}"
      placeholder="微信/手机号/邮箱，方便我们回复您"
      bind:input="onContactInput"
    />
  </view>

  <view class="submit-area">
    <button
      class="submit-btn"
      bind:tap="onSubmit"
      disabled="{{!canSubmit}}"
      loading="{{submitting}}"
    >提交反馈</button>
  </view>

</view>
