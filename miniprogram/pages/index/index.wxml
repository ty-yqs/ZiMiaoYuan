<!--
  首页 — 紫喵园
  1. 轮播头图
  2. 今日猫咪推荐
  3. 快捷入口
-->
<view class="page-container">

  <!-- ==================== 轮播头图 ==================== -->
  <!-- 加载占位：预留头图空间，避免加载完成后整体内容下移 -->
  <view wx:if="{{bannersLoading}}" class="banner-swiper banner-placeholder" />

  <swiper
    wx:elif="{{banners.length > 0}}"
    class="banner-swiper"
    indicator-dots
    indicator-color="rgba(255,255,255,0.5)"
    indicator-active-color="#ffffff"
    autoplay
    circular
    interval="{{4000}}"
    duration="{{500}}"
  >
    <swiper-item wx:for="{{banners}}" wx:key="_id">
      <image
        class="banner-img"
        src="{{item.src}}"
        mode="aspectFill"
        bind:tap="onTapBanner"
        data-link="{{item.link}}"
      />
    </swiper-item>
  </swiper>

  <!-- ==================== 今日猫咪推荐 ==================== -->
  <view class="section">
    <view class="section-header flex-between">
      <view class="section-title flex-row">
        <image class="section-title-icon" src="/images/icons/cloud.sun@4x.png" mode="heightFix" />
        <text>今日猫咪推荐</text>
      </view>
      <text class="section-more" bind:tap="onTapAllCats">查看全部 ›</text>
    </view>

    <!-- 加载骨架：模拟猫咪卡片布局，与真实猫卡同尺寸，避免加载后内容位移 -->
    <block wx:if="{{loading}}">
      <view class="cat-card-skeleton" wx:for="{{[1,2]}}" wx:key="*this">
        <view class="sk-avatar" />
        <view class="sk-body">
          <view class="sk-line sk-name" />
          <view class="sk-line sk-desc" />
          <view class="sk-line sk-loc" />
          <view class="sk-line sk-footer" />
        </view>
      </view>
    </block>

    <!-- 错误 -->
    <view wx:elif="{{error}}" class="error-wrapper">
      <van-empty description="{{error}}" />
      <view class="retry-btn" bind:tap="loadFeaturedCats">点击重试</view>
    </view>

    <!-- 猫咪卡片列表 -->
    <block wx:elif="{{featuredCats.length > 0}}">
      <cat-card
        wx:for="{{featuredCats}}"
        wx:key="_id"
        cat="{{item}}"
        showRecentTime="{{true}}"
        showLocation="{{false}}"
      />
    </block>

    <!-- 空状态 -->
    <view class="empty-state" wx:else>
      <text class="empty-icon">🐱</text>
      <text class="empty-text">还没有猫咪档案，快来发现第一只猫吧！</text>
    </view>
  </view>

  <!-- ==================== 快捷入口 ==================== -->
  <view class="section">
    <view class="section-header">
      <view class="section-title flex-row">
        <image class="section-title-icon" src="/images/icons/camera.viewfinder@4x.png" mode="heightFix" />
        <text>快捷入口</text>
      </view>
    </view>

    <view class="quick-entries">
      <view
        class="entry-item card flex-column flex-center"
        wx:for="{{quickEntries}}"
        wx:key="label"
        data-url="{{item.url}}"
        bind:tap="onTapEntry"
      >
        <text class="entry-icon">{{item.icon}}</text>
        <text class="entry-label">{{item.label}}</text>
      </view>
    </view>
  </view>

  <!-- 底部安全区 -->
  <view class="safe-bottom-spacer" />

  <!-- ==================== 科普弹窗 ==================== -->
  <view class="poster-overlay" wx:if="{{showPoster}}" catch:tap="onClosePoster">
    <view class="poster-modal" catch:tap="noop">
      <image class="poster-modal-img" src="/images/poster.jpg" mode="widthFix" />
      <view class="poster-close" bind:tap="onClosePoster">✕</view>
    </view>
  </view>

</view>
