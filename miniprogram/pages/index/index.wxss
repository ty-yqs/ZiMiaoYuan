/**
 * 首页样式
 */

/* ========== 错误 ========== */
.error-wrapper {
  padding-top: 80rpx;
  text-align: center;
}

.retry-btn {
  display: inline-block;
  margin-top: var(--spacing-md);
  padding: 12rpx 40rpx;
  color: var(--color-primary);
  font-size: var(--font-md);
  border: 1rpx solid var(--color-primary);
  border-radius: var(--radius-round);
}

/* ========== 轮播头图 ========== */
.banner-swiper {
  margin: var(--spacing-md);
  height: 360rpx;
  border-radius: var(--radius-lg);
  overflow: hidden;
}

.banner-placeholder {
  background: linear-gradient(90deg, #eef0f2 25%, #f6f7f8 37%, #eef0f2 63%);
  background-size: 400% 100%;
  animation: sk-shimmer 1.4s ease infinite;
}

.banner-img {
  width: 100%;
  height: 100%;
  display: block;
}

/* ========== 今日推荐 加载骨架 ========== */
.cat-card-skeleton {
  display: flex;
  flex-direction: row;
  padding: 20rpx;
  margin: 16rpx 24rpx;
  background: #fffffffa;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-md);
}

.sk-avatar,
.sk-line {
  background: linear-gradient(90deg, #eef0f2 25%, #f6f7f8 37%, #eef0f2 63%);
  background-size: 400% 100%;
  animation: sk-shimmer 1.4s ease infinite;
}

.sk-avatar {
  flex-shrink: 0;
  width: 140rpx;
  height: 140rpx;
  border-radius: var(--radius-md);
}

.sk-body {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.sk-line {
  border-radius: 8rpx;
}

/* 行高与 cat-card 一致：name 44 / desc 36 / loc 36 / footer 36 */
.sk-name {
  height: 32rpx;
  width: 60%;
  margin-bottom: 12rpx;
}
.sk-desc {
  height: 22rpx;
  width: 90%;
  margin-bottom: 14rpx;
}
.sk-loc {
  height: 22rpx;
  width: 70%;
  margin-bottom: 14rpx;
}
.sk-footer {
  height: 22rpx;
  width: 40%;
  margin-bottom: 14rpx;
}

@keyframes sk-shimmer {
  0% {
    background-position: 100% 50%;
  }
  100% {
    background-position: 0 50%;
  }
}

/* ========== 区块通用 ========== */
.section {
  margin-top: var(--spacing-sm);
}

.section-header {
  padding: var(--spacing-md) var(--spacing-md) var(--spacing-sm);
}

.section-title {
  font-size: var(--font-lg);
  font-weight: 600;
  color: var(--color-text-primary);
}

.section-title-icon {
  height: 30rpx;
  margin-right: 8rpx;
}

.section-more {
  font-size: var(--font-sm);
  color: var(--color-primary);
}

/* ========== 快捷入口 ========== */
.quick-entries {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  justify-content: flex-start;
  gap: 8rpx;
  padding: 0 var(--spacing-md);
}

.entry-item {
  width: calc((100% - 24rpx) / 4);
  height: 0;
  padding: 0;
  padding-bottom: calc((100% - 24rpx) / 4);
  margin: 0;
  border-radius: var(--radius-md);
  position: relative;
  overflow: hidden;
}

.entry-item:active {
  background: var(--color-bg);
}

.entry-icon {
  position: absolute;
  top: 24%;
  left: 50%;
  transform: translateX(-50%);
  font-size: 40rpx;
}

.entry-label {
  position: absolute;
  top: 62%;
  left: 50%;
  transform: translateX(-50%);
  font-size: var(--font-xs);
  color: var(--color-text-secondary);
  white-space: nowrap;
}

/* ========== 安全区 ========== */
.safe-bottom-spacer {
  height: calc(var(--safe-area-bottom) + 40rpx);
}

/* ========== 科普弹窗 ========== */
.poster-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: 999;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.poster-modal {
  width: 80%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.poster-modal-img {
  width: 100%;
  border-radius: var(--radius-md);
}

.poster-close {
  margin-top: 40rpx;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.3);
  color: #fff;
  font-size: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
