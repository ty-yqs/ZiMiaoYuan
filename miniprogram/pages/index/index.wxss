/**
 * 首页样式
 */

/* ========== Banner 区域 ========== */
.banner {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: var(--spacing-xl) var(--spacing-lg);
  margin: var(--spacing-md);
  background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-light) 100%);
  border-radius: var(--radius-lg);
  color: #fff;
  overflow: hidden;
  position: relative;
}

.banner-content {
  display: flex;
  flex-direction: column;
  z-index: 1;
}

.banner-title {
  font-size: var(--font-xxl);
  font-weight: 700;
  margin-bottom: var(--spacing-xs);
}

.banner-subtitle {
  font-size: var(--font-sm);
  opacity: 0.9;
}

.banner-decor {
  position: absolute;
  right: 20rpx;
  top: 20rpx;
  width: 150rpx;
  height: 150rpx;
  opacity: 0.9;
  z-index: 0;
}

/* ========== 区块通用 ========== */
.section {
  margin-top: var(--spacing-sm);
}

.section-header {
  padding: var(--spacing-md) var(--spacing-md) var(--spacing-sm);
}

.section-title {
  font-size: var(--font-lg);
  font-weight: 600;
  color: var(--color-text-primary);
}

.section-title-icon {
  height: 30rpx;
  margin-right: 8rpx;
}

.section-more {
  font-size: var(--font-sm);
  color: var(--color-primary);
}

/* ========== 快捷入口 ========== */
.quick-entries {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  justify-content: flex-start;
  gap: 8rpx;
  padding: 0 var(--spacing-md);
}

.entry-item {
  width: calc((100% - 24rpx) / 4);
  height: 0;
  padding: 0;
  padding-bottom: calc((100% - 24rpx) / 4);
  margin: 0;
  border-radius: var(--radius-md);
  position: relative;
  overflow: hidden;
}

.entry-item:active {
  background: var(--color-bg);
}

.entry-icon {
  position: absolute;
  top: 24%;
  left: 50%;
  transform: translateX(-50%);
  font-size: 40rpx;
}

.entry-label {
  position: absolute;
  top: 62%;
  left: 50%;
  transform: translateX(-50%);
  font-size: var(--font-xs);
  color: var(--color-text-secondary);
  white-space: nowrap;
}

/* ========== 安全区 ========== */
.safe-bottom-spacer {
  height: calc(var(--safe-area-bottom) + 40rpx);
}

/* ========== 科普弹窗 ========== */
.poster-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: 999;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.poster-modal {
  width: 80%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.poster-modal-img {
  width: 100%;
  border-radius: var(--radius-md);
}

.poster-close {
  margin-top: 40rpx;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.3);
  color: #fff;
  font-size: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
