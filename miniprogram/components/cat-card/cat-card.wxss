/**
 * cat-card — 猫咪卡片样式
 */

/* ========== 卡片容器 ========== */
.cat-card {
  display: flex;
  flex-direction: row;
  padding: 20rpx;
  margin: 16rpx 24rpx;
  background: #fffffffa;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-md);
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
  transition: transform 0.15s ease;
}

.cat-card:active {
  transform: scale(0.985);
  background: var(--color-bg);
}

/* ========== 头像区 ========== */
.card-avatar {
  position: relative;
  flex-shrink: 0;
  width: 140rpx;
  height: 140rpx;
  border-radius: var(--radius-md);
  overflow: hidden;
  background: var(--color-bg-warm);
}

.avatar-img {
  width: 100%;
  height: 100%;
}

/* 性别角标 */
.gender-badge {
  position: absolute;
  bottom: 4rpx;
  right: 4rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: var(--radius-round);
  display: flex;
  align-items: center;
  justify-content: center;
}

.gender-badge-img {
  width: 24rpx;
  height: 24rpx;
}

.gender-badge.male {
  background: #5B9BD5;
}

.gender-badge.female {
  background: #E8749F;
}

/* ========== 信息区 ========== */
.card-body {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-width: 0;
}

.card-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-bottom: 8rpx;
}

.card-row:last-child {
  margin-bottom: 0;
}

/* ========== 第一行：名字 + 毛色 ========== */
.cat-name {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  max-width: 280rpx;
  margin-right: 12rpx;
}

.color-tag {
  flex-shrink: 0;
  font-size: 22rpx;
  color: var(--color-primary-dark);
  background: rgba(126, 200, 168, 0.12);
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
}

.age-label {
  flex-shrink: 0;
  font-size: 22rpx;
  color: var(--color-accent);
  background: rgba(242, 166, 90, 0.12);
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  margin-right: 8rpx;
}

/* ========== 第二行：地点 ========== */
.row-icon {
  font-size: 24rpx;
  margin-right: 4rpx;
  flex-shrink: 0;
}

.row-text {
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

/* ========== 第三行：健康 + 时间 ========== */
.card-footer {
  justify-content: space-between;
}

.health-dots {
  display: flex;
  gap: 8rpx;
}

.dot {
  width: 36rpx;
  height: 36rpx;
  border-radius: var(--radius-round);
  border: 2rpx solid var(--color-border);
  font-size: 20rpx;
  color: var(--color-text-hint);
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.dot.on {
  background: var(--color-primary);
  border-color: var(--color-primary);
  color: #fff;
}

.recent-time {
  font-size: 22rpx;
  color: var(--color-text-hint);
}

/* ========== Compact 模式 ========== */
.cat-card.compact {
  padding: 16rpx 20rpx;
  margin: 8rpx 24rpx;
}

.cat-card.compact .card-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: var(--radius-round);
}

.cat-card.compact .cat-name {
  font-size: 28rpx;
}

.cat-card.compact .gender-badge {
  width: 28rpx;
  height: 28rpx;
}

.cat-card.compact .gender-badge-img {
  width: 18rpx;
  height: 18rpx;
}
